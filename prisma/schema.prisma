// Coffee Shop Ordering System — Guest checkout, no customer accounts
// SQLite local dev database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─── Enums ──────────────────────────────────────────────

enum OrderStatus {
  baru        // Baru / New
  diproses    // Diproses / Processing
  siap_diambil // Siap Diambil / Ready
  selesai     // Selesai / Done
}

enum Role {
  admin
  kasir
}

// ─── Models ─────────────────────────────────────────────

model Category {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  menuItems   MenuItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MenuItem {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  price       Int     // Rupiah, e.g. 25000 = Rp 25.000
  imageUrl    String?
  available   Boolean @default(true)

  // stores: size, sugar level, ice level, extra shot, toppings
  customizationOptions Json

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([available])
}

model Order {
  id           Int         @id @default(autoincrement())
  orderNumber  String      // Display number for customer, e.g. "0042" — unique per orderDate, see @@unique below
  orderDate    String      // "YYYY-MM-DD" local date, used to reset orderNumber sequence daily
  orderToken   String      @unique // Unguessable guest tracking token (crypto.randomUUID)
  customerName String?
  tableNumber  String?
  status       OrderStatus @default(baru)
  totalPrice   Int         // Rupiah total

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt]) // Composite: "show all pending orders today"
  @@unique([orderDate, orderNumber]) // orderNumber resets daily, unique only within same day
}

model OrderItem {
  id       Int @id @default(autoincrement())
  quantity Int @default(1)

  // Snapshots at order time — menu changes don't affect these
  itemName   String
  unitPrice  Int  // Rupiah at time of order
  subtotal   Int  // unitPrice * quantity
  customization Json

  orderId    Int
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Null after the source menu item is deleted — snapshots keep order history intact
  menuItemId Int?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([menuItemId])
}

model AdminUser {
  id           Int    @id @default(autoincrement())
  username     String @unique
  passwordHash String
  name         String
  role         Role   @default(kasir)

  createdAt DateTime @default(now())
}

// Singleton row (id fixed at 1) — shop-wide settings editable from the admin dashboard
model ShopSetting {
  id        Int      @id @default(1)
  openHour  String?  // "HH:mm" — null = banner off
  closeHour String?  // "HH:mm" — null = banner off

  // Shop identity printed on the customer receipt (all optional — receipt
  // falls back to SHOP_INFO defaults in src/lib/settings.ts when null)
  shopName    String?
  shopAddress String?
  shopPhone   String?
  logoUrl     String? // served from /api/uploads/menu/[file] — uploaded via admin

  updatedAt DateTime @updatedAt
}
